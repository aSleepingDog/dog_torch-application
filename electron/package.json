{
  "name": "dog_torch_electron",
  "version": "1.1.1",
  "description": "simple cryptology tool based on electron",
  "main": "index.js",
  "scripts": {
    "start:win": "electron .",
    "start:mac": "electron .",
    "start:linux": "electron . --no-sandbox --ozone-platform=x11",
    "pack": "electron-builder --dir",
    "dist:win-x64": "electron-builder --win --x64",
    "dist:linux-x64": "electron-builder --linux --x64",
    "dist:mac": "electron-builder --mac --arm64"
  },
  "author": "aSleepingDog",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sleepingdog.dogtorch",
    "productName": "DogTorch",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.js",
      "main.js",
      "preload.js",
      "*.html",
      "*.css",
      "icon.ico",
      "package.json",
      "native/**/*.node",
      "resource/*"
    ],
    "extraResources": [
      {
        "from": "native/",
        "to": "native/",
        "filter": ["**/*.node"]
      },
      {
        "from": "resource/",
        "to": "resource/"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DogTorch"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "icon": "icon.ico"
    }
  }
}
